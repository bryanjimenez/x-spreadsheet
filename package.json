{
  "name": "@nmemonica/x-spreadsheet",
  "version": "0.1.0-alpha.0",
  "description": "A Typescript xpreadsheet",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./helper": {
      "default": "./dist/helper.js",
      "types": "./dist/types/helper.d.ts"
    },
    "./types/*": "./dist/types/*.d.ts",
    "./locale/*": {
      "default": "./dist/locale/*.json",
      "types": "./dist/types/locale/*.d.ts"
    },
    "./less.css": "./dist/less.css"
  },
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_LICENSE"
  ],
  "author": "bryanjimenez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryanjimenez/x-spreadsheet.git"
  },
  "scripts": {
    "dev": "rspack serve -c ./build/rspack.dev.js",
    "prebuild": "rm -rf ./dist",
    "build": "rspack build -c ./build/rspack.prod.js",
    "postbuild": "npm run build-dts",
    "build-dts": "tsc -p ./tsconfig.types.json | cat",
    "test": "node --test ./test/*.ts ./test/**/*.ts",
    "coverage": "node --test --experimental-test-coverage ./test/*.ts ./test/**/*.ts",
    "staged": "git diff --staged --diff-filter=d --name-only",
    "lint": "npm run -s staged | xargs eslint --fix",
    "lint:all": "DEBUG=*,-@hwc*,-eslint:code-path eslint ."
  },
  "keywords": [
    "javascript",
    "spreadsheet",
    "canvas"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.3.3",
    "@rspack/core": "^2.3.3",
    "@rspack/dev-server": "^2.2.2",
    "@types/md5": "^2.3.5",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom-global": "^3.0.2",
    "less-loader": "^12.3.1",
    "license-checker-webpack-plugin": "^0.2.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
